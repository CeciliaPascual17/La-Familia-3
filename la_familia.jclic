 <sequence>
  <item id="start" name="La Familia" />
 </sequence>
 <activities>
  <activity class="@memory.MemoryGame" name="La Familia" code="">
   <description />
   <messages>
    <cell type="initial">
     <style />
     <p>Bienvenido!</p>
    </cell>
    <cell type="final">
     <style />
     <p>Buen trabajo!</p>
    </cell>
    <cell type="finalError">
     <style />
     <p>Lo siento! vuelve a intentarlo.</p>
    </cell>
   </messages>
   <settings margin="11" report="true" reportActions="false">
    <container bgColor="0xC0C0C0">
     <image name="Familia.jpg" tiled="true" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFFCC00" border="false">
     <position x="41" y="28" />
    </window>
   </settings>
   <cells rows="2" cols="2" cellWidth="415.0" cellHeight="205.0" border="true" id="primary">
    <style />
    <shaper class="@Rectangular" cols="2" rows="2" />
    <cell txtAlign="middle,bottom" image="MAMÀ-resized.jpg">
     <style borderStroke="0.7" markerStroke="5.0">
      <color foreground="0xCC0000" />
     </style>
     <media type="PLAY_AUDIO" level="1" file="Mamà.wav" />
     <p>MAMÀ</p>
    </cell>
    <cell txtAlign="middle,bottom" image="PAPÀ-resized.jpg">
     <style borderStroke="0.7" markerStroke="5.0">
      <color foreground="0xCC0000" />
     </style>
     <media type="PLAY_AUDIO" level="1" file="Papà.wav" />
     <p>PAPÀ</p>
    </cell>
    <cell txtAlign="middle,bottom" image="Abuelo-resized.jpg">
     <style borderStroke="0.7" markerStroke="5.0">
      <color foreground="0xCC0000" />
     </style>
     <media type="PLAY_AUDIO" level="1" file="ABUELO.wav" />
     <p>ABUELO</p>
    </cell>
    <cell txtAlign="middle,bottom" image="abuela.jpg">
     <style borderStroke="0.7" markerStroke="5.0">
      <color foreground="0xCC0000" />
     </style>
     <media type="PLAY_AUDIO" level="1" file="ABUELA.wav" />
     <p>ABUELA</p>
    </cell>
   </cells>
   <scramble times="31" />
   <layout position="AB" />
  </activity>
 </activities>
